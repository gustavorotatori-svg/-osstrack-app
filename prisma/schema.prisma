generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Academia {
  id        String   @id @default(cuid())
  nome      String
  endereco  String
  cidade    String
  estado    String
  lat       Float
  lng       Float
  raio      Int      @default(200)
  responsavel String
  telefone  String
  whatsapp  String?
  pixKey    String?
  logo      String?
  horarioInicio String?
  horarioFim    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios        Usuario[]
  turmas          Turma[]
  graduacoes      Graduacao[]
  mestresDoMes    MestreDoMes[]
  postagensMural  PostagemMural[]
  horariosAula    HorarioAula[]
  agendamentos    Agendamento[]
  convites        Convite[]
  checkinCodigos  CheckinCodigo[]
  rankingVisivel  Boolean  @default(true)
  planosMensalidade PlanoMensalidade[]
  contratos         Contrato[]
  cobrancas         Cobranca[]
  despesas          Despesa[]
}

model Usuario {
  id         String   @id @default(cuid())
  nome       String
  email      String   @unique
  senha      String
  role       String   @default("aluno")
  telefone   String?
  avatar     String?
  faixa      String   @default("Branca")
  grau       Int      @default(0)
  dataInicio DateTime?
  categoria  String   @default("adulto")
  academiaId String?
  academia   Academia? @relation(fields: [academiaId], references: [id])
  professorId String?
  emailVerificationToken String?
  emailVerified DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  presencas       Presenca[]
  turmasAluno     TurmaAluno[]
  turmas          Turma[]
  alunos          Usuario[]           @relation("ProfessorAlunos")
  professor       Usuario?            @relation("ProfessorAlunos", fields: [professorId], references: [id])
  metasSemanais   MetaSemanal[]
  missoesDiarias  MissaoDiaria[]
  postagensMural  PostagemMural[]
  mestreDoMes     MestreDoMes[]
  notificacoes    Notificacao[]
  comentariosMural ComentarioMural[]
  curtidasMural CurtidaMural[]
  horariosAula    HorarioAula[]
  streak          Streak?
  contratos       Contrato[]
  cobrancas       Cobranca[]
  agendamentos    Agendamento[]
  convites        Convite[]
  pontos          Int      @default(0)
  tourVisto       Boolean  @default(false)
  aceitouTermos   Boolean  @default(false)
  aceitouLGPD     Boolean  @default(false)
  aceitouMarketing Boolean @default(false)
  dataAceite      DateTime?
   resetToken      String?
   resetTokenExpires DateTime?
   dataNascimento  String?
   nivelDisciplina String?
   pushSubscriptions PushSubscription[]
   premiumSubscription PremiumSubscription?
 }

model PlanoMensalidade {
  id         String   @id @default(cuid())
  academiaId String
  academia   Academia @relation(fields: [academiaId], references: [id])
  nome       String
  valor      Int
  taxaMatricula Int  @default(0)
  descricao  String?
  periodo    String   @default("mensal")
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contratos  Contrato[]
}

model Contrato {
  id         String   @id @default(cuid())
  alunoId    String
  aluno      Usuario  @relation(fields: [alunoId], references: [id])
  academiaId String
  academia   Academia @relation(fields: [academiaId], references: [id])
  planoId    String
  plano      PlanoMensalidade @relation(fields: [planoId], references: [id])
  valor      Int
  dataInicio DateTime
  dataFim    DateTime?
  status     String   @default("ativo")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cobrancas  Cobranca[]
}

model Cobranca {
  id             String    @id @default(cuid())
  contratoId     String
  contrato       Contrato  @relation(fields: [contratoId], references: [id])
  alunoId        String
  aluno          Usuario   @relation(fields: [alunoId], references: [id])
  academiaId     String
  academia       Academia  @relation(fields: [academiaId], references: [id])
  valor          Int
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         String    @default("pendente")
  metodo         String?
  observacao     String?
  pagoEm         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Turma {
  id          String   @id @default(cuid())
  nome        String
  descricao   String?
  cor         String   @default("#C9A84C")
  icone       String   @default("🥋")
  categoria   String   @default("adulto")
  horario     String
  dias        String
  maxAlunos   Int      @default(30)
  academiaId  String
  academia    Academia @relation(fields: [academiaId], references: [id])
  professorId String
  professor   Usuario  @relation(fields: [professorId], references: [id])
  createdAt   DateTime @default(now())

  alunos    TurmaAluno[]
  horarios  HorarioAula[]
}

model TurmaAluno {
  id       String @id @default(cuid())
  turmaId  String
  turma    Turma  @relation(fields: [turmaId], references: [id])
  alunoId  String
  aluno    Usuario @relation(fields: [alunoId], references: [id])

  @@unique([turmaId, alunoId])
}

model Presenca {
  id          String   @id @default(cuid())
  alunoId     String
  aluno       Usuario  @relation(fields: [alunoId], references: [id])
  data        DateTime
  horario     String
  status      String   @default("pendente")
  turma       String?
  observacao  String?
  confirmadoPor String?
  createdAt   DateTime @default(now())
}

model Graduacao {
  id              String   @id @default(cuid())
  academiaId      String
  academia        Academia @relation(fields: [academiaId], references: [id])
  categoria       String   @default("adulto")
  faixa           String
  graus           Int
  aulasPorGrau    Int
  aulasProxFx     Int?
  aulasMinimasAno Int?
  dataProva       DateTime?
  regraTroca      String   @default("graus")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Conquista {
  id                String @id @default(cuid())
  nome              String
  icone             String
  iconeBloqueado    String @default("🔒")
  descricao         String
  tipo              String
  categoria         String @default("presenca")
  condicao          Int
  nivel             Int    @default(1)
  nivelLabel        String @default("bronze")
  raridade          String @default("comum")
  progressoMax      Int    @default(1)

  alunosConquista   AlunoConquista[]
}

model AlunoConquista {
  id          String   @id @default(cuid())
  alunoId     String
  conquistaId String
  conquista   Conquista @relation(fields: [conquistaId], references: [id])
  progresso   Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([alunoId, conquistaId])
}

model MestreDoMes {
  id        String   @id @default(cuid())
  academiaId String
  academia  Academia @relation(fields: [academiaId], references: [id])
  alunoId   String
  aluno     Usuario  @relation(fields: [alunoId], references: [id])
  mes       Int
  ano       Int
  categoria String   @default("adulto")
  totalAulas Int
  createdAt DateTime @default(now())

  @@unique([academiaId, mes, ano, categoria])
}

model MetaSemanal {
  id        String   @id @default(cuid())
  alunoId   String
  aluno     Usuario  @relation(fields: [alunoId], references: [id])
  semanaInicio DateTime
  aulasAlvo Int      @default(5)
  aulasFeitas Int    @default(0)
  concluida Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MissaoDiaria {
  id          String   @id @default(cuid())
  alunoId     String
  aluno       Usuario  @relation(fields: [alunoId], references: [id])
  dia         Int
  titulo      String
  descricao   String
  icone       String
  tipo        String   @default("onboarding")
  concluida   Boolean  @default(false)
  pontos      Int      @default(10)
  resetToken  String?
  createdAt   DateTime @default(now())
}

model PostagemMural {
  id        String   @id @default(cuid())
  academiaId String
  academia  Academia @relation(fields: [academiaId], references: [id])
  alunoId   String
  aluno     Usuario  @relation(fields: [alunoId], references: [id])
  tipo      String
  conteudo  String
  imagem    String?
  curtidas  Int      @default(0)
  createdAt DateTime @default(now())

  comentarios ComentarioMural[]
  curtidasList CurtidaMural[]
}

model CurtidaMural {
  id         String   @id @default(cuid())
  postagemId String
  postagem   PostagemMural @relation(fields: [postagemId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([postagemId, usuarioId])
}

model ComentarioMural {
  id         String   @id @default(cuid())
  postagemId String
  postagem   PostagemMural @relation(fields: [postagemId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  conteudo   String
  createdAt  DateTime @default(now())
}

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tipo      String
  titulo    String
  descricao String
  lida      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Streak {
  id              String   @id @default(cuid())
  usuarioId       String   @unique
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  currentStreak   Int      @default(0)
  bestStreak      Int      @default(0)
  lastCheckinDate DateTime?
  streakFreeze    Int      @default(1)
  freezeUsado     Boolean  @default(false)
  semanaFreeze    String?
  updatedAt       DateTime @updatedAt
}

model HorarioAula {
  id          String   @id @default(cuid())
  academiaId  String
  academia    Academia @relation(fields: [academiaId], references: [id])
  turmaId     String
  turma       Turma    @relation(fields: [turmaId], references: [id])
  professorId String
  professor   Usuario  @relation(fields: [professorId], references: [id])
  diaSemana   Int
  horaInicio  String
  horaFim     String
  maxAlunos   Int      @default(30)
  local       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agendamentos Agendamento[]
}

model Convite {
  id          String    @id @default(cuid())
  tipo        String
  codigo      String    @unique
  remetenteId String
  academiaId  String?
  professorId String?
  email       String?
  usado       Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  remetente Usuario  @relation(fields: [remetenteId], references: [id])
  academia  Academia? @relation(fields: [academiaId], references: [id])
}

model Agendamento {
  id           String   @id @default(cuid())
  academiaId   String
  academia     Academia @relation(fields: [academiaId], references: [id])
  horarioId    String
  horario      HorarioAula @relation(fields: [horarioId], references: [id])
  alunoId      String
  aluno        Usuario  @relation(fields: [alunoId], references: [id])
  data         DateTime
  status       String   @default("confirmado")
  createdAt    DateTime @default(now())

  @@unique([horarioId, alunoId, data])
}

model PushSubscription {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PremiumSubscription {
  id             String    @id @default(cuid())
  usuarioId      String    @unique
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])
  stripeCustomerId String?
  stripeSubscriptionId String?
  status         String    @default("inactive")
  plan           String    @default("premium")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean  @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Despesa {
  id          String   @id @default(cuid())
  academiaId  String
  academia    Academia @relation(fields: [academiaId], references: [id])
  descricao   String
  valor       Int
  categoria   String   @default("outras")
  dataVencimento DateTime
  dataPagamento  DateTime?
  status      String   @default("pendente")
  observacao  String?
  pagoEm      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contato {
  id        String   @id @default(cuid())
  nome      String
  email     String
  mensagem  String
  lido      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Lead {
  id          String   @id @default(cuid())
  nome        String
  email       String
  academia    String?
  telefone    String?
  baixouEbook Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model CheckinCodigo {
  id        String   @id @default(cuid())
  academiaId String
  academia  Academia @relation(fields: [academiaId], references: [id])
  criadoPor String
  codigo    String
  turma     String?
  usado     Boolean  @default(false)
  usadoPor  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RateLimitAttempt {
  id         String   @id @default(cuid())
  identifier String   // e.g., "email:test@test.com" or "ip:192.168.1.1"
  endpoint   String   // e.g., "login", "register", "recuperar-senha"
  attempts   Int      @default(1)
  windowStart DateTime
  updatedAt  DateTime @updatedAt

  @@unique([identifier, endpoint])
  @@index([identifier, endpoint, windowStart])
}
