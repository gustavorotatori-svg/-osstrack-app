generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Academia {
  id        String   @id @default(cuid())
  nome      String
  endereco  String
  cidade    String
  estado    String
  lat       Float
  lng       Float
  raio      Int      @default(200)
  responsavel String
  telefone  String
  whatsapp  String?
  pixKey    String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios        Usuario[]
  turmas          Turma[]
  graduacoes      Graduacao[]
  mestresDoMes    MestreDoMes[]
  postagensMural  PostagemMural[]
  planos          PlanoMensalidade[]
  contratos       Contrato[]
  cobrancas       Cobranca[]
  horariosAula    HorarioAula[]
  agendamentos    Agendamento[]
}

model Usuario {
  id         String   @id @default(cuid())
  nome       String
  email      String   @unique
  senha      String
  role       String   @default("aluno")
  telefone   String?
  avatar     String?
  faixa      String   @default("Branca")
  grau       Int      @default(0)
  dataInicio DateTime?
  categoria  String   @default("adulto")
  academiaId String?
  academia   Academia? @relation(fields: [academiaId], references: [id])
  professorId String?
  plano      String   @default("free")
  planoInicio DateTime?
  planoExpiracao DateTime?
  stripeCustomerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  presencas       Presenca[]
  turmasAluno     TurmaAluno[]
  turmas          Turma[]
  alunos          Usuario[]           @relation("ProfessorAlunos")
  professor       Usuario?            @relation("ProfessorAlunos", fields: [professorId], references: [id])
  metasSemanais   MetaSemanal[]
  missoesDiarias  MissaoDiaria[]
  postagensMural  PostagemMural[]
  mestreDoMes     MestreDoMes[]
  notificacoes    Notificacao[]
  comentariosMural ComentarioMural[]
  horariosAula    HorarioAula[]
  streak          Streak?
  pagamentos      Pagamento[]
  contratos       Contrato[]
  cobrancas       Cobranca[]
  agendamentos    Agendamento[]
}

model Pagamento {
  id             String   @id @default(cuid())
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  valor          Int
  status         String   @default("pending")
  metodo         String?
  stripeId       String?
  stripeSessionId String?
  mesReferencia  Int
  anoReferencia  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Turma {
  id          String   @id @default(cuid())
  nome        String
  horario     String
  dias        String
  maxAlunos   Int      @default(30)
  academiaId  String
  academia    Academia @relation(fields: [academiaId], references: [id])
  professorId String
  professor   Usuario  @relation(fields: [professorId], references: [id])
  createdAt   DateTime @default(now())

  alunos    TurmaAluno[]
  horarios  HorarioAula[]
}

model TurmaAluno {
  id       String @id @default(cuid())
  turmaId  String
  turma    Turma  @relation(fields: [turmaId], references: [id])
  alunoId  String
  aluno    Usuario @relation(fields: [alunoId], references: [id])
}

model Presenca {
  id          String   @id @default(cuid())
  alunoId     String
  aluno       Usuario  @relation(fields: [alunoId], references: [id])
  data        DateTime
  horario     String
  status      String   @default("pendente")
  turma       String?
  observacao  String?
  confirmadoPor String?
  createdAt   DateTime @default(now())
}

model Graduacao {
  id              String   @id @default(cuid())
  academiaId      String
  academia        Academia @relation(fields: [academiaId], references: [id])
  categoria       String   @default("adulto")
  faixa           String
  graus           Int
  aulasPorGrau    Int
  aulasProxFx     Int?
  aulasMinimasAno Int?
  dataProva       DateTime?
  regraTroca      String   @default("graus")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Conquista {
  id          String @id @default(cuid())
  nome        String
  icone       String
  descricao   String
  tipo        String
  condicao    Int

  alunosConquista AlunoConquista[]
}

model AlunoConquista {
  id          String   @id @default(cuid())
  alunoId     String
  conquistaId String
  conquista   Conquista @relation(fields: [conquistaId], references: [id])
  createdAt   DateTime @default(now())
}

model MestreDoMes {
  id        String   @id @default(cuid())
  academiaId String
  academia  Academia @relation(fields: [academiaId], references: [id])
  alunoId   String
  aluno     Usuario  @relation(fields: [alunoId], references: [id])
  mes       Int
  ano       Int
  totalAulas Int
  createdAt DateTime @default(now())

  @@unique([academiaId, mes, ano])
}

model MetaSemanal {
  id        String   @id @default(cuid())
  alunoId   String
  aluno     Usuario  @relation(fields: [alunoId], references: [id])
  semanaInicio DateTime
  aulasAlvo Int      @default(5)
  aulasFeitas Int    @default(0)
  concluida Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MissaoDiaria {
  id          String   @id @default(cuid())
  alunoId     String
  aluno       Usuario  @relation(fields: [alunoId], references: [id])
  dia         Int
  titulo      String
  descricao   String
  icone       String
  concluida   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model PostagemMural {
  id        String   @id @default(cuid())
  academiaId String
  academia  Academia @relation(fields: [academiaId], references: [id])
  alunoId   String
  aluno     Usuario  @relation(fields: [alunoId], references: [id])
  tipo      String
  conteudo  String
  createdAt DateTime @default(now())

  comentarios ComentarioMural[]
}

model ComentarioMural {
  id         String   @id @default(cuid())
  postagemId String
  postagem   PostagemMural @relation(fields: [postagemId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  conteudo   String
  createdAt  DateTime @default(now())
}

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tipo      String
  titulo    String
  descricao String
  lida      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Streak {
  id              String   @id @default(cuid())
  usuarioId       String   @unique
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  currentStreak   Int      @default(0)
  bestStreak      Int      @default(0)
  lastCheckinDate DateTime?
  updatedAt       DateTime @updatedAt
}

model PlanoMensalidade {
  id          String   @id @default(cuid())
  academiaId  String
  academia    Academia @relation(fields: [academiaId], references: [id])
  nome        String
  valor       Float
  descricao   String?
  recorrencia String   @default("mensal")
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contratos Contrato[]
}

model Contrato {
  id          String   @id @default(cuid())
  academiaId  String
  academia    Academia @relation(fields: [academiaId], references: [id])
  alunoId     String
  aluno       Usuario  @relation(fields: [alunoId], references: [id])
  planoId     String
  plano       PlanoMensalidade @relation(fields: [planoId], references: [id])
  valor       Float
  diaVencimento Int    @default(5)
  dataInicio  DateTime
  dataFim     DateTime?
  status      String   @default("ativo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cobrancas Cobranca[]
}

model Cobranca {
  id             String   @id @default(cuid())
  academiaId     String
  academia       Academia @relation(fields: [academiaId], references: [id])
  contratoId     String
  contrato       Contrato @relation(fields: [contratoId], references: [id])
  alunoId        String
  aluno          Usuario  @relation(fields: [alunoId], references: [id])
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         String   @default("pendente")
  metodo         String?
  referencia     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HorarioAula {
  id          String   @id @default(cuid())
  academiaId  String
  academia    Academia @relation(fields: [academiaId], references: [id])
  turmaId     String
  turma       Turma    @relation(fields: [turmaId], references: [id])
  professorId String
  professor   Usuario  @relation(fields: [professorId], references: [id])
  diaSemana   Int
  horaInicio  String
  horaFim     String
  maxAlunos   Int      @default(30)
  local       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agendamentos Agendamento[]
}

model Agendamento {
  id           String   @id @default(cuid())
  academiaId   String
  academia     Academia @relation(fields: [academiaId], references: [id])
  horarioId    String
  horario      HorarioAula @relation(fields: [horarioId], references: [id])
  alunoId      String
  aluno        Usuario  @relation(fields: [alunoId], references: [id])
  data         DateTime
  status       String   @default("confirmado")
  createdAt    DateTime @default(now())

  @@unique([horarioId, alunoId, data])
}
