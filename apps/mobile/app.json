{
  "expo": {
    "name": "OssTrack",
    "slug": "osstrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "osstrack",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0a",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.osstrack.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.osstrack.app",
      "permissions": ["CAMERA", "RECEIVE_BOOT_COMPLETED", "VIBRATE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Precisamos da câmera para escanear QR codes de check-in." }],
      ["expo-notifications", { "icon": "./assets/notification-icon.png" }]
    ]
  }
}
